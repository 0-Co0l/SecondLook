# Copy to .env (chmod 600) and fill in. Never commit .env. All settings: §4.5 of .github/copilot-instructions.md.

# --- Server -------------------------------------------------------------------
# 127.0.0.1 for local development. 0.0.0.0 only behind a proxy or platform, and never with AUTH_MODE=none.
APP_HOST=127.0.0.1
APP_PORT=8000
# Proxies allowed to set X-Forwarded-For (read by Uvicorn). Keep 127.0.0.1 unless behind Caddy/a platform.
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=info
WORKERS=2

# --- Data -----------------------------------------------------------------------
DATA_DIR=./data
# SQLite only on a local disk with one instance; PostgreSQL otherwise:
#   postgresql+psycopg://user:pass@host:5432/secondlook
DATABASE_URL=sqlite:///./data/app.db
RETENTION_HOURS=168

STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Generate once and keep safe; losing it makes stored files unreadable:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- Access control (§4.6) ------------------------------------------------------------
# none (local development only) | access_code (small pilot) | oidc (not implemented in v1)
AUTH_MODE=none
ACCESS_CODE=
# Optional; derived from FILE_ENCRYPTION_KEY when empty.
SESSION_SECRET=
OIDC_ISSUER=
OIDC_AUDIENCE=

# --- LLM (§6.7) ------------------------------------------------------------------
# anthropic | fake (offline canned findings; only allowed with AUTH_MODE=none)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# us = U.S.-only inference (+10% token price); leave empty for global
LLM_INFERENCE_GEO=us
# Retry a safety-classifier refusal on Anthropic's recommended fallback model (server-side).
LLM_REFUSAL_FALLBACK=true

# --- Redaction --------------------------------------------------------------------
SPACY_MODEL=en_core_web_md
# pymupdf (AGPL/commercial) | permissive (pypdfium2 + pdfplumber + Pillow); see LICENSING.md
PDF_BACKEND=pymupdf
PDF_TIMEOUT_SECONDS=60
# A or B once the PyMuPDF licensing decision is recorded in LICENSING.md
LICENSE_PATH_CONFIRMED=
# Path A only: public URL of the exact running source, shown in the app footer
SOURCE_CODE_URL=

# --- Docker Compose (Profile A) ---------------------------------------------------
DOMAIN=
